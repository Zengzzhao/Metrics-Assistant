DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 设置 true 并填入 Key 后上传图节点、模型输入输出、图片 URL、耗时与 token 用量。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ie
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Neo4j 入库（需要单独启动 Neo4j 数据库）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 知识问答（复用上面的 DeepSeek 和 Neo4j 配置）
QA_MODEL=deepseek-flash
QA_MODEL_TIMEOUT=60
QA_MAX_OUTPUT_TOKENS=12000
# 问答默认关闭长思考；如启用 enabled，需相应增加输出预算和超时。
QA_THINKING=disabled
